{
  "name": "Furiosa — Query Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "furiosa/query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-query",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "field-text",
              "name": "text",
              "value": "={{ $json.body.text }}",
              "type": "string"
            },
            {
              "id": "field-device",
              "name": "device_id",
              "value": "={{ $json.body.device_id ?? 'furiosa_01' }}",
              "type": "string"
            },
            {
              "id": "field-mode",
              "name": "mode",
              "value": "={{ $json.body.mode ?? 'dashboard' }}",
              "type": "string"
            },
            {
              "id": "field-lang",
              "name": "lang",
              "value": "={{ $json.body.lang ?? 'es' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-fields",
      "name": "Normalizar Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "table": {
          "__rl": true,
          "value": "Furiosa_DeviceState",
          "mode": "list"
        },
        "key": {
          "attributes": [
            {
              "attributeType": "S",
              "name": "device_id",
              "value": "={{ $('Normalizar Input').item.json.device_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "dynamo-state",
      "name": "DynamoDB Estado",
      "type": "n8n-nodes-base.awsDynamoDB",
      "typeVersion": 1,
      "position": [700, 160],
      "credentials": {
        "aws": {
          "id": "furiosa-aws-cred",
          "name": "Furiosa-AWS"
        }
      }
    },
    {
      "parameters": {
        "operation": "query",
        "table": {
          "__rl": true,
          "value": "Furiosa_Maintenance",
          "mode": "list"
        },
        "keyConditionExpression": "device_id = :d",
        "expressionAttributeValues": {
          "attributes": [
            {
              "attribute": ":d",
              "value": "={{ $('Normalizar Input').item.json.device_id }}",
              "type": "S"
            }
          ]
        },
        "options": {
          "scanIndexForward": false,
          "limit": 1
        }
      },
      "id": "dynamo-maintenance",
      "name": "DynamoDB Mantenimiento",
      "type": "n8n-nodes-base.awsDynamoDB",
      "typeVersion": 1,
      "position": [700, 300],
      "credentials": {
        "aws": {
          "id": "furiosa-aws-cred",
          "name": "Furiosa-AWS"
        }
      }
    },
    {
      "parameters": {
        "operation": "scan",
        "table": {
          "__rl": true,
          "value": "Furiosa_Sessions",
          "mode": "list"
        },
        "filterExpression": "device_id = :d",
        "expressionAttributeValues": {
          "attributes": [
            {
              "attribute": ":d",
              "value": "={{ $('Normalizar Input').item.json.device_id }}",
              "type": "S"
            }
          ]
        },
        "options": {
          "limit": 5
        }
      },
      "id": "dynamo-sessions",
      "name": "DynamoDB Sesiones",
      "type": "n8n-nodes-base.awsDynamoDB",
      "typeVersion": 1,
      "position": [700, 440],
      "credentials": {
        "aws": {
          "id": "furiosa-aws-cred",
          "name": "Furiosa-AWS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text      = $('Normalizar Input').item.json.text;\nconst mode      = $('Normalizar Input').item.json.mode;\nconst lang      = $('Normalizar Input').item.json.lang;\nconst device_id = $('Normalizar Input').item.json.device_id;\n\nconst stateItem = $('DynamoDB Estado').item.json.Item ?? {};\nconst estado = {\n  temperatura_motor_c: stateItem.engine_temp?.N ?? 'N/A',\n  rpm:                 stateItem.rpm?.N ?? 'N/A',\n  velocidad_kmh:       stateItem.speed?.N ?? 'N/A',\n  voltaje:             stateItem.voltage?.N ?? 'N/A',\n  ultima_conexion:     stateItem.last_seen?.N ?? 'N/A',\n};\n\nconst maintItems = $('DynamoDB Mantenimiento').item.json.Items ?? [];\nconst maint = maintItems.length > 0 ? {\n  aceite_km_restantes:   maintItems[0].remaining_km_oil?.N ?? 'N/A',\n  freno_delantero_km:    maintItems[0].remaining_km_brake_front?.N ?? 'N/A',\n  freno_trasero_km:      maintItems[0].remaining_km_brake_rear?.N ?? 'N/A',\n  cadena_km:             maintItems[0].remaining_km_chain?.N ?? 'N/A',\n  llanta_delantera_km:   maintItems[0].remaining_km_tire_front?.N ?? 'N/A',\n  llanta_trasera_km:     maintItems[0].remaining_km_tire_rear?.N ?? 'N/A',\n  urgencia:              maintItems[0].urgency?.S ?? 'ok',\n  componente_critico:    maintItems[0].most_critical_component?.S ?? 'ninguno',\n} : { mensaje: 'Sin datos de mantenimiento aun' };\n\nconst sessionItems = $('DynamoDB Sesiones').item.json.Items ?? [];\nconst sesiones = sessionItems.map(s => ({\n  fecha:            s.date?.S ?? 'N/A',\n  distancia_km:     s.distance_km?.N ?? '0',\n  duracion_min:     s.duration_min?.N ?? '0',\n  velocidad_max:    s.speed_max_kmh?.N ?? '0',\n  score_conduccion: s.driving_score?.N ?? '0',\n  score_eficiencia: s.efficiency_score?.N ?? '0',\n  tipo_ruta:        s.route_type?.S ?? 'N/A',\n}));\n\nconst context = {\n  estado_actual:    estado,\n  mantenimiento:    maint,\n  ultimas_sesiones: sesiones,\n};\n\nreturn [{ json: { text, mode, lang, device_id, context: JSON.stringify(context, null, 2) } }];"
      },
      "id": "code-context",
      "name": "Armar Contexto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://lambda.us-east-1.amazonaws.com/2015-03-31/functions/furiosa-voice-command-handler/invocations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "aws",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Amz-Invocation-Type",
              "value": "RequestResponse"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\":      \"{{ $json.text }}\",\n  \"device_id\": \"{{ $json.device_id }}\",\n  \"mode\":      \"{{ $json.mode }}\",\n  \"context\":   {{ $json.context }}\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "http-lambda",
      "name": "Invocar Lambda L4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 300],
      "credentials": {
        "aws": {
          "id": "furiosa-aws-cred",
          "name": "Furiosa-AWS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let body = $json.body ?? $json;\nif (typeof body === 'string') body = JSON.parse(body);\nlet response = body;\nif (typeof body.body === 'string') response = JSON.parse(body.body);\n\nreturn [{\n  json: {\n    response_text: response.response_text ?? 'No pude procesar tu consulta',\n    intent:        response.intent ?? 'QUERY',\n    action:        response.action ?? 'none',\n    language:      response.language ?? 'es',\n    success:       true,\n  }\n}];"
      },
      "id": "code-parse",
      "name": "Parsear Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1380, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"response_text\": \"{{ $json.response_text }}\",\n  \"intent\":        \"{{ $json.intent }}\",\n  \"language\":      \"{{ $json.language }}\",\n  \"success\":       true\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-webhook",
      "name": "Responder Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1600, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Normalizar Input", "type": "main", "index": 0 }]]
    },
    "Normalizar Input": {
      "main": [[
        { "node": "DynamoDB Estado",        "type": "main", "index": 0 },
        { "node": "DynamoDB Mantenimiento", "type": "main", "index": 0 },
        { "node": "DynamoDB Sesiones",      "type": "main", "index": 0 }
      ]]
    },
    "DynamoDB Estado":        { "main": [[{ "node": "Armar Contexto", "type": "main", "index": 0 }]] },
    "DynamoDB Mantenimiento": { "main": [[{ "node": "Armar Contexto", "type": "main", "index": 1 }]] },
    "DynamoDB Sesiones":      { "main": [[{ "node": "Armar Contexto", "type": "main", "index": 2 }]] },
    "Armar Contexto":   { "main": [[{ "node": "Invocar Lambda L4",  "type": "main", "index": 0 }]] },
    "Invocar Lambda L4": { "main": [[{ "node": "Parsear Respuesta", "type": "main", "index": 0 }]] },
    "Parsear Respuesta": { "main": [[{ "node": "Responder Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [{ "name": "furiosa" }, { "name": "query" }],
  "active": false
}

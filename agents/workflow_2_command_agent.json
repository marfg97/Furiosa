{
  "name": "Furiosa — Command Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "furiosa/command",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-command",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "text",      "value": "={{ $json.body.text }}",                          "type": "string" },
            { "id": "f2", "name": "device_id", "value": "={{ $json.body.device_id ?? 'furiosa_01' }}",     "type": "string" },
            { "id": "f3", "name": "mode",      "value": "={{ $json.body.mode ?? 'riding' }}",              "type": "string" },
            { "id": "f4", "name": "tag",       "value": "={{ $json.body.tag ?? 'waypoint' }}",             "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-fields",
      "name": "Normalizar Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://lambda.us-east-1.amazonaws.com/2015-03-31/functions/furiosa-voice-command-handler/invocations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "aws",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type",          "value": "application/json" },
            { "name": "X-Amz-Invocation-Type", "value": "RequestResponse" }
          ]
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\":      \"{{ $json.text }}\",\n  \"device_id\": \"{{ $json.device_id }}\",\n  \"mode\":      \"{{ $json.mode }}\"\n}",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "http-lambda",
      "name": "Invocar Lambda L4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "credentials": {
        "aws": { "id": "furiosa-aws-cred", "name": "Furiosa-AWS" }
      }
    },
    {
      "parameters": {
        "jsCode": "let body = $json.body ?? $json;\nif (typeof body === 'string') body = JSON.parse(body);\nlet response = body;\nif (typeof body.body === 'string') response = JSON.parse(body.body);\n\nreturn [{\n  json: {\n    response_text:   response.response_text ?? 'Comando procesado',\n    action:          response.action ?? 'none',\n    action_params:   response.action_params ?? {},\n    intent:          response.intent ?? 'COMMAND',\n    language:        response.language ?? 'es',\n    device_id:       $('Normalizar Input').item.json.device_id,\n    tag:             $('Normalizar Input').item.json.tag,\n  }\n}];"
      },
      "id": "code-parse",
      "name": "Extraer Acción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "reset_oil",         "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "reset_oil" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "reset_brake_front", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "reset_brake_front" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "reset_brake_rear",  "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "reset_brake_rear" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "reset_chain",        "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "reset_chain" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "reset_tire_front",   "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "reset_tire_front" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "reset_tire_rear",    "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "reset_tire_rear" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "mark_waypoint",      "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "mark_waypoint" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "start_recording",    "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "start_recording" },
            { "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "stop_recording",     "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "stop_recording" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "switch-action",
      "name": "Switch Acción",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1140, 300]
    },
